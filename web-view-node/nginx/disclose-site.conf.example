# 招采信息披露（web-view-node）— Nginx 443 反代示例
# 用法：复制到 /etc/nginx/sites-available/，改 server_name 与证书路径后启用；
#       防火墙放行 443，关闭对公网的 TCP 5000。
#
# 证书：可用 Let's Encrypt（certbot）、或公司内 CA 签发的 PEM。

# HTTP 跳转 HTTPS（可选，若仅内网 HTTP 可删此 server）
server {
    listen 80;
    listen [::]:80;
    server_name ztb.resoftcss.com.cn;
    return 301 https://$host$request_uri;
}

# 若 nginx >= 1.25，可改为：listen 443 ssl;  http2 on;  listen [::]:443 ssl;
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ztb.resoftcss.com.cn;

    # ----- TLS：按实际路径修改 -----
    ssl_certificate     /etc/nginx/ssl/ztb.resoftcss.com.cn.fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/ztb.resoftcss.com.cn.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 可选：OCSP Stapling（证书链完整且 CA 支持时）
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate /etc/nginx/ssl/ztb.resoftcss.com.cn.chain.pem;

    client_max_body_size 8m;

    # 可选安全响应头
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 若只写了 location /ztb-test/digest/ 而没有整段 /ztb-test/，
    # 则转发卡片里的 /ztb-test/detail/xxx?fr= 会在 Nginx 层 404，浏览器提示「页面无法访问」。
    # 请保证下列之一：
    #   (1) 用下面的整块前缀反代到 Node（与摘要、详情、API 同一端口进程）；
    #   (2) 或保留 location / { proxy_pass ... } 全覆盖。
    #
    # location /ztb-test/ {
    #     proxy_pass http://127.0.0.1:5001;
    #     proxy_http_version 1.1;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
